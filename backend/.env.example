MONGODB_URI=mongodb://localhost:27017/gmeet-attendance
PORT=3000

# Shared secret the extension must send as X-Extension-Token on every /api/* request.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
EXTENSION_TOKEN=

# The extension's stable chrome-extension:// origin, allowed by CORS.
# Find it at chrome://extensions after loading the unpacked extension.
EXTENSION_ORIGIN=chrome-extension://YOUR_EXTENSION_ID_HERE

# LLM provider used to generate meeting minutes: "anthropic" (default) or "groq".
LLM_PROVIDER=anthropic

# Required when LLM_PROVIDER=anthropic. Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Required when LLM_PROVIDER=groq. Get one at https://console.groq.com/
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
